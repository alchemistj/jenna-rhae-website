---
/**
 * Primary call to action. `href` comes from bookHref(hasBooking): "#book" on a page with the embed,
 * "/contact/#book" elsewhere. Never an external link.
 * `location` is the journey-tracking ctaLocation. It is an attribute, not visible copy.
 */
import type { CtaLocation } from "../lib/measurement/ctaLocation";

interface Props {
  label: string;
  href: string;
  location: CtaLocation;
  class?: string;
  variant?: "accent" | "outline";
}
const { label, href, location, class: className, variant = "accent" } = Astro.props;
const text = label.replace("Consultation Call", "Consultation\u00A0Call");
---

<a href={href} class:list={[variant === "outline" ? "btn-outline" : "btn-accent", className]} data-book data-cta-location={location}>{text}</a>
