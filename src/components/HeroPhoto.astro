---
/**
 * The hero photo, first element in <body>. One final AVIF inlined once as a data URI (35 to 60 KB), a real <img>,
 * eager, high priority, sync decoding, with real width and height. No preload, no placeholder, no fade.
 * The scrim comes after the <img> in source, so nothing paints ahead of the photo.
 * The scrim is a gradient behind the text, not a full dark overlay.
 */
import { getHeroPhoto } from "../lib/inlineImage";
import type { ImageKey } from "../lib/images";

interface Props {
  image: ImageKey;
  alt: string;
  objectPosition?: string;
  /** Flip horizontally. The stylesheet applies it from tablet width up. */
  mirror?: boolean;
}
const { image, alt, objectPosition = "center center", mirror = false } = Astro.props;
const heroFile = image === "hero-home" ? "hero-home-wheat.jpg" : `${image}.jpg`;
const photo = await getHeroPhoto(heroFile);
---

<img
  class="atf-photo"
  src={photo.dataUri}
  alt={alt}
  width={photo.width}
  height={photo.height}
  loading="eager"
  decoding="sync"
  fetchpriority="high"
  data-ff-lcp-hero
  data-hero={image}
  data-mirror={mirror ? "true" : undefined}
  style={`object-position: ${objectPosition}`}
/>
<div class="atf-scrim" aria-hidden="true"></div>
