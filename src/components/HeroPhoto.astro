---
/**
 * The hero photo, first element in <body>. One final AVIF inlined once as a data URI (35 to 60 KB), a real <img>,
 * eager, high priority, sync decoding, with real width and height. No preload, no placeholder, no fade.
 * The scrim comes after the <img> in source, so nothing paints ahead of the photo.
 */
import { getHeroPhoto } from "../lib/inlineImage";
import type { ImageKey } from "../lib/images";

interface Props {
  image: ImageKey;
  alt: string;
  objectPosition?: string;
  /** 0 to 100 */
  overlayOpacity?: number;
}
const { image, alt, objectPosition = "center top", overlayOpacity = 55 } = Astro.props;
const photo = await getHeroPhoto(`${image}.jpg`);
---

<img
  class="atf-photo"
  src={photo.dataUri}
  alt={alt}
  width={photo.width}
  height={photo.height}
  loading="eager"
  decoding="sync"
  fetchpriority="high"
  data-ff-lcp-hero
  style={`object-position: ${objectPosition}`}
/>
<div class="atf-scrim" style={`background-color: rgb(28 28 28 / ${overlayOpacity / 100})`} aria-hidden="true"></div>
