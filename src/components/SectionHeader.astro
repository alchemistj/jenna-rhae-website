---
/** Centered eyebrow + H2 used at the top of most bands. */
import { lockHeading } from "../lib/heading";

interface Props {
  eyebrow?: string;
  heading: string;
  class?: string;
}
const { eyebrow, heading, class: className = "mb-10" } = Astro.props;
---

<div class:list={["text-center", className]}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="heading-rule">{lockHeading(heading)}</h2>
</div>
