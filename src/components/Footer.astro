---
/** Site footer. Copy from src/data/site.ts. Legal links render only for published routes. */
import { footer, header } from "../data/site";
import { isPublished } from "../lib/routeRegistry";
import { isContactHref } from "../lib/measurement/contactHref";
import { getInlineLogo } from "../lib/inlineImage";
import { EMAIL, MAILTO } from "../lib/site";

interface Props {
  bookHref: string;
}
const { bookHref } = Astro.props;
const legal = footer.legal.filter((item) => isPublished(item.href));
const logo = await getInlineLogo("jenna-logo.png", 160);
const logoHeight = Math.round(logo.height / 2);
const copyright = footer.copyright.replace(/\b20\d{2}\b/, String(new Date().getFullYear()));
const pageLinks = header.nav.filter((item) =>
  ["/", "/about/", "/blog/", "/contact/"].includes(item.href) && isPublished(item.href),
);

const serviceLinks: Record<string, string> = {
  "Trauma Recovery Coaching": "/trauma-coaching/",
  "Christian Life Coaching": "/christian-life-coach-kansas-city-mo/",
  "Christian Coaching in Kansas City, MO": "/christian-life-coach-kansas-city-mo/",
  "Tenacious Grace (Emotional Eating)": "/tenacious-grace/",
  "Free Consultation Call": "/contact/#book",
};

/** Keep city names and dash phrases from splitting. The words stay the same. */
function hold(text: string): string {
  return text.replaceAll("Kansas City, MO", "Kansas\u00A0City,\u00A0MO").replaceAll(" — ", "\u00A0—\u00A0");
}
---

<footer class="site-footer bg-charcoal text-cream">
  <div class="container-narrow py-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 xl:grid-cols-4 xl:gap-8">
      <div>
        <a href="/" class="mb-4 inline-flex rounded-lg bg-cream px-3 py-2">
          <img src={logo.dataUri} alt="JennaRhae" width="160" height={logoHeight} class="h-auto w-[160px]" />
        </a>
        <p class="mb-4 text-sm leading-relaxed text-cream/85">{footer.about}</p>
        <ul class="space-y-2 text-sm text-cream/85">
          <li>
            <a href={MAILTO} class="footer-link">{EMAIL}</a>
          </li>
          <li>
            <a href={bookHref} class="footer-link" data-cta-location="footer">{footer.bookLink}</a>
          </li>
          <li class="text-cream/70">{footer.appointment}</li>
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-4">{footer.servicesHeading}</p>
        <ul class="space-y-2 text-sm text-cream/85">
          {
            footer.services.map((item) => {
              const href = serviceLinks[item];
              return (
                <li>
                  {href ? (
                    <a href={href} class="footer-link" data-cta-location={isContactHref(href) ? "footer" : undefined}>
                      {item}
                    </a>
                  ) : (
                    item
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-4">{footer.servingHeading}</p>
        <ul class="space-y-2 text-sm text-cream/85">
          {footer.serving.map((item) => <li>{hold(item)}</li>)}
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-4">{footer.whyHeading}</p>
        <ul class="space-y-2 text-sm text-cream/85">
          {
            footer.why.map((item) => (
              <li class="flex gap-2">
                <span class="text-gold" aria-hidden="true">
                  ✓
                </span>
                <span>{hold(item)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <nav class="mt-10 flex flex-col items-center gap-2 text-sm md:flex-row md:flex-wrap md:gap-x-5 md:gap-y-2" aria-label={header.navLabel}>
      {
        pageLinks.map((item) => (
          <a href={item.href} class="footer-link whitespace-nowrap" data-cta-location={isContactHref(item.href) ? "footer" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-8 border-t border-cream/20 pt-6 text-sm text-cream/75">
      <nav class="mb-3 flex flex-col items-center gap-2 md:flex-row md:gap-4">
        {legal.map((item) => <a href={item.href} class="footer-link whitespace-nowrap py-1">{item.label}</a>)}
      </nav>
      <div class="flex flex-col items-center gap-2 md:flex-row md:items-baseline md:justify-between">
        <p class="md:whitespace-nowrap">{copyright}</p>
        <p class="text-center md:whitespace-nowrap">{hold(footer.tagline)}</p>
      </div>
    </div>
  </div>
</footer>
