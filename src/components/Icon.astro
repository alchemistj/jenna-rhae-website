---
/** Small inline SVG icons (decorative; paths from the Lucide set used by the mockup). */
interface Props {
  name: "check" | "mail" | "map-pin" | "monitor" | "menu" | "close";
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {name === "check" && <path d="M20 6 9 17l-5-5" />}
  {
    name === "mail" && (
      <>
        <rect width="20" height="16" x="2" y="4" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </>
    )
  }
  {
    name === "map-pin" && (
      <>
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </>
    )
  }
  {
    name === "monitor" && (
      <>
        <rect width="20" height="14" x="2" y="3" rx="2" />
        <path d="M8 21h8M12 17v4" />
      </>
    )
  }
  {name === "menu" && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === "close" && <path d="M18 6 6 18M6 6l12 12" />}
</svg>
