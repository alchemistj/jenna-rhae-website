---
/**
 * Generic deferred third-party iframe (Rule 10). The server HTML has no <iframe> and no iframe src:
 * the URL sits in data-src and in a <noscript> link. The script below creates the iframe on the first scroll,
 * wheel, touchstart, pointerdown or keydown, or when 10% of the box is in the viewport,
 * whichever is first. The box reserves its height so nothing shifts when the frame loads.
 * Used by BookingEmbed (SpringboardCRM) and the free trauma test (LeadConnector quiz).
 */
interface Props {
  src: string;
  title: string;
  /** Text of the <noscript> fallback link. */
  noscriptLabel: string;
  /** Reserved height in px at md and up. */
  height?: number;
  /** Reserved height in px below md. */
  mobileHeight?: number;
  id?: string;
}
const { src, title, noscriptLabel, height = 820, mobileHeight = 900, id } = Astro.props;
---

<div
  id={id}
  class="deferred-embed"
  data-deferred-iframe
  data-src={src}
  data-title={title}
  style={`--embed-h: ${height}px; --embed-h-mobile: ${mobileHeight}px`}
>
  <noscript>
    <p class="embed-fallback"><a class="link-accent underline" href={src} rel="noopener noreferrer">{noscriptLabel}</a></p>
  </noscript>
</div>

<script>
  const EVENTS = ["scroll", "wheel", "touchstart", "pointerdown", "keydown"] as const;
  const boxes = Array.from(document.querySelectorAll<HTMLElement>("[data-deferred-iframe]"));

  const load = (box: HTMLElement) => {
    if (box.dataset.loaded || !box.dataset.src) return;
    box.dataset.loaded = "true";
    const frame = document.createElement("iframe");
    frame.src = box.dataset.src;
    frame.title = box.dataset.title ?? "";
    frame.setAttribute("allow", "payments");
    box.appendChild(frame);
  };

  if (boxes.length > 0) {
    const loadAll = () => {
      for (const name of EVENTS) window.removeEventListener(name, loadAll);
      observer?.disconnect();
      boxes.forEach(load);
    };
    for (const name of EVENTS) window.addEventListener(name, loadAll, { passive: true, once: true });

    const observer =
      "IntersectionObserver" in window
        ? new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  load(entry.target as HTMLElement);
                  observer?.unobserve(entry.target);
                }
              }
            },
            { rootMargin: "0px", threshold: 0.1 },
          )
        : null;
    boxes.forEach((box) => observer?.observe(box));
  }
</script>
