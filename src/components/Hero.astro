---
/**
 * Hero text block: eyebrow, the only H1, a bold lead line, one supporting line, the primary CTA and optional meta list.
 * It sits over HeroPhoto inside the .atf block. Keep it close to the photo in the HTML.
 */
import type { HeroData } from "../data/types";
import BookButton from "./BookButton.astro";
import Icon from "./Icon.astro";

interface Props {
  hero: HeroData;
  bookHref: string;
}
const { hero, bookHref } = Astro.props;
---

<section class="hero" aria-labelledby="page-title">
  <div class="container-narrow py-20 md:py-28">
    <div class="max-w-2xl">
      <div class="eyebrow mb-4" style="--eyebrow: rgb(250 247 244 / 0.88)">{hero.eyebrow}</div>
      <h1 id="page-title" class="mb-5 text-cream">{hero.title}</h1>
      <div class="mb-8 text-base leading-relaxed md:text-lg" style="color: rgb(250 247 244 / 0.95)">
        <p class="mb-2 font-bold">{hero.subtitleBold}</p>
        <p>{hero.subtitle}</p>
      </div>
      <BookButton label={hero.ctaLabel} href={bookHref} class="text-base" />
      {
        hero.meta && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm" style="color: rgb(250 247 244 / 0.95)">
            {hero.meta.map((item) => (
              <li class="flex items-center gap-2">
                <Icon name={item.icon} size={16} class="text-gold" />
                {item.mailto ? (
                  <a href={`mailto:${item.text}`} class="underline underline-offset-2">
                    {item.text}
                  </a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
