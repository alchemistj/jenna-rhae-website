---
/**
 * Hero text block: optional eyebrow, the only H1, a bold lead line, one supporting line, the primary CTA and optional meta list.
 * It sits over HeroPhoto inside the .atf block. Keep it close to the photo in the HTML.
 * Title-only heroes (About) omit the lead, the support line and the button.
 */
import { Image } from "astro:assets";
import type { HeroData } from "../data/types";
import { lockHeading } from "../lib/heading";
import { getImageMeta } from "../lib/images";
import BookButton from "./BookButton.astro";
import Icon from "./Icon.astro";

interface Props {
  hero: HeroData;
  bookHref: string;
}
const { hero, bookHref } = Astro.props;
const flower = hero.flower ? getImageMeta("wp-flower-icon") : null;
---

<section class="hero" aria-labelledby="page-title">
  <div class="container-narrow py-16 md:py-28">
    <div class="hero-copy">
      {hero.eyebrow && <p class="eyebrow mb-4" style="--eyebrow: rgb(250 247 244 / 0.88)">{hero.eyebrow}</p>}
      <div class="mb-5 flex items-center gap-3">
        {
          flower && (
            <Image
              src={flower}
              alt=""
              width={48}
              height={33}
              format="png"
              loading="eager"
              decoding="sync"
              class="h-8 w-auto shrink-0"
            />
          )
        }
        <h1 id="page-title" class="text-cream">{lockHeading(hero.title)}</h1>
      </div>
      {
        (hero.subtitleBold || hero.subtitle) && (
          <div class="mb-8 text-base leading-relaxed md:text-lg" style="color: rgb(250 247 244 / 0.95)">
            {hero.subtitleBold && <p class="mb-2 font-bold">{hero.subtitleBold}</p>}
            {hero.subtitle && <p>{hero.subtitle}</p>}
          </div>
        )
      }
      {hero.ctaLabel && <BookButton label={hero.ctaLabel} href={bookHref} location="hero" />}
      {
        hero.meta && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm" style="color: rgb(250 247 244 / 0.95)">
            {hero.meta.map((item) => (
              <li class="flex items-center gap-2">
                <Icon name={item.icon} size={16} class="text-gold" />
                {item.mailto ? (
                  <a href={`mailto:${item.text}`} class="underline underline-offset-2">
                    {item.text}
                  </a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
