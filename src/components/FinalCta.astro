---
/** Final call-to-action band. Draft words live in site.ts and are pending Jenna's approval. */
import { finalCta } from "../data/site";
import BookButton from "./BookButton.astro";

interface Props {
  bookHref: string;
}
const { bookHref } = Astro.props;
---

<section class="band-red w-full py-16 md:py-24">
  <div class="container-narrow">
    <div class="mx-auto max-w-[44rem] text-center">
      <h2 class="mb-5 font-display text-3xl font-normal leading-tight text-cream md:text-4xl">{finalCta.heading}</h2>
      <p class="mb-8 text-cream">{finalCta.body}</p>
      <BookButton label={finalCta.ctaLabel} href={bookHref} location="cta_band" variant="outline" />
    </div>
  </div>
</section>
