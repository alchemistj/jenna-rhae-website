---
/**
 * Unknown URLs. Astro writes this to dist/404.html, which Vercel serves for missing paths.
 * The words are the draft in site.ts, pending Jenna's approval. Not in the sitemap or llms.txt.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { header, notFound } from "../data/site";
import type { PageData } from "../data/types";

const page = {
  path: "/404/",
  seo: {
    title: notFound.title,
    description: notFound.body,
  },
  blocks: [],
} satisfies PageData;

const links = header.nav.filter((item) => ["/", "/trauma-coaching/", "/contact/"].includes(item.href));
---

<BaseLayout page={page} robots="noindex, nofollow" unlisted>
  <section class="w-full band-cream py-16 md:py-24">
    <div class="container-narrow">
      <div class="mx-auto max-w-[44rem] text-center">
        <h1 class="mb-6">{notFound.heading}</h1>
        <p class="soft mb-8">{notFound.body}</p>
        <ul class="flex flex-col items-center gap-4">
          {links.map((item) => <li><a class="link-accent text-lg" href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
